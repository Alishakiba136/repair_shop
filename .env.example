# ==========================================
# Execution Mode (Dual Mode Architecture)
# ==========================================
# Choose between:
# - 'local': 100% offline-capable, Local Playwright + Local LLM (Ollama/LM Studio) + SQLite
# - 'cloud': Cloud LLMs (Gemini / OpenAI) + optional cloud notifications
EXECUTION_MODE="local"

# ==========================================
# Local LLM Configuration (Ollama / LM Studio / LocalAI)
# ==========================================
# Provider options: 'ollama', 'lm_studio', 'localai', 'custom'
LOCAL_LLM_PROVIDER="ollama"
# Endpoint URL (Ollama default: http://localhost:11434, LM Studio default: http://localhost:1234/v1)
LOCAL_LLM_ENDPOINT="http://localhost:11434"
# Model identifier (e.g. 'llama3', 'llama3:8b', 'mistral', 'qwen2.5', 'phi3')
LOCAL_LLM_MODEL="llama3"
# Timeout in seconds for local inference queries
LOCAL_LLM_TIMEOUT_SEC="45"
# If local LLM fails or is unreachable, fallback to rule-based or cloud model
FALLBACK_ON_LOCAL_FAILURE="true"

# ==========================================
# Cloud AI Provider Configuration (Optional / Fallback)
# ==========================================
# GEMINI_API_KEY: Required only for Cloud Mode with Gemini AI
GEMINI_API_KEY=""
# OPENAI_API_KEY: Required only for Cloud Mode with OpenAI
OPENAI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:5000"

# ==========================================
# Kleinanzeigen Scraper Configuration
# ==========================================

# Optional Telegram Bot alerts for newly discovered defective deals
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Target search configuration (Dortmund is l2078)
SCRAPER_LOCATION_NAME="dortmund"
SCRAPER_LOCATION_ID="2078"
SCRAPER_KEYWORDS="defekt,für Bastler,an Bastler,Ersatzteile"
SCRAPER_MAX_PAGES="2"

# Profitability filter thresholds (EUR)
MIN_PROFIT_EUR="30.0"
MAX_REPAIR_BUDGET="150.0"

# Optional proxy for high-volume rotating runs
SCRAPER_PROXY_URL=""


